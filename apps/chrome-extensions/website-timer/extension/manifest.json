{
  "manifest_version": 3,
  "name": "Website Timer",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "A red visit and daily timer for Facebook and Rotten Tomatoes, with optional daily budgets and bedtime cutoffs.",
  "permissions": [
    "storage",
    "idle",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.rottentomatoes.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Website Timer · limits and today",
    "default_popup": "popup.html"
  },
  "options_page": "popup.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.rottentomatoes.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "*://*.facebook.com/*",
        "*://*.rottentomatoes.com/*"
      ]
    }
  ]
}
