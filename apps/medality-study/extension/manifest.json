{
  "manifest_version": 3,
  "name": "Medality Remember Speed",
  "version": "1.2.0",
  "description": "Remember video speed and copy or save available Medality transcripts for your study workspace.",
  "permissions": ["storage", "clipboardWrite"],
  "action": { "default_title": "Medality speed & transcripts", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "commands": {
    "copy-transcript": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Copy the current Medality transcript"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.medality.com/*", "https://*.mrionline.com/*"],
      "js": ["vendor/vimeo-player.min.js", "content.js", "transcript-core.js", "transcript.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://starfox1230.github.io/The-Library/apps/medality-study/*"],
      "js": ["workspace-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
