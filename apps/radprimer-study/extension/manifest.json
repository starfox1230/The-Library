{
  "manifest_version": 3,
  "name": "RadPrimer · Case Library",
  "version": "1.0.1",
  "description": "Save the current RadPrimer case, its image groups and explanations for private review and a focused Anki queue.",
  "permissions": ["unlimitedStorage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open your RadPrimer case library" },
  "content_scripts": [{
    "matches": ["https://app.radprimer.com/*"],
    "js": ["core.js", "capture.js", "content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data:; connect-src 'none'" }
}
