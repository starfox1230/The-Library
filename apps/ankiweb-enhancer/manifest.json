{
  "manifest_version": 3,
  "name": "AnkiWeb Enhancer — Milestone 1",
  "version": "0.1.4",
  "description": "Private keyboard controls for AnkiWeb review. Uses AnkiWeb's existing buttons and scheduling.",
  "content_scripts": [
    {
      "matches": ["https://ankiweb.net/*", "https://ankiuser.net/*"],
      "js": ["src/content/anki-dom.js", "src/content/keyboard.js", "src/content/answer-feedback.js", "src/content/card-cleanup.js", "src/content/content.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
