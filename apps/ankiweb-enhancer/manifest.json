{
  "manifest_version": 3,
  "name": "AnkiWeb Enhancer — Milestone 3",
  "version": "0.3.0",
  "description": "Private keyboard controls, review stats, pace timer, focus mode, and night mode for AnkiWeb.",
  "content_scripts": [
    {
      "matches": ["https://ankiweb.net/*", "https://ankiuser.net/*"],
      "css": ["src/content/review-modes.css", "src/content/session.css"],
      "js": ["src/content/anki-dom.js", "src/content/keyboard.js", "src/content/answer-feedback.js", "src/content/card-cleanup.js", "src/content/review-modes.js", "src/content/session.js", "src/content/content.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
