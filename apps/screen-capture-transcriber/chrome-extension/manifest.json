{
  "manifest_version": 3,
  "name": "Screen Capture Transcriber Link",
  "version": "1.3.0",
  "description": "Links Medality and YouTube video playback to the local Screen Capture Transcriber.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:43129/*",
    "https://medality.com/*",
    "https://*.medality.com/*",
    "https://player.vimeo.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://medality.com/course/*",
        "https://www.medality.com/course/*"
      ],
      "run_at": "document_idle",
      "js": ["medality-transcript.js"]
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "run_at": "document_idle",
      "js": ["youtube-transcript.js"]
    },
    {
      "matches": [
        "https://player.vimeo.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content-script.js"]
    }
  ],
  "action": {
    "default_title": "Screen Capture Transcriber Link",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
