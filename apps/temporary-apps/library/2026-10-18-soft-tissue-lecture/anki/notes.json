  {
    "id": "soft-tissue-lecture-v1-ct-15",
    "source_page_id": "ct-15",
    "source_title": "Subhawong et al. AJR 2010, Figure 15, PDF page 6.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "Gardner syndrome. What is the most likely diagnosis?<br><br>{{c1::Desmoid-type fibromatosis}}<br><br><img src=\"stlecture_ct_f15_single_v1.jpg\">",
      "Extra": "A rectus abdominis mass in this clinical setting supports a desmoid tumor; its attenuation is similar to muscle.<br><br>Subhawong et al. AJR 2010, Figure 15, PDF page 6.<br><br><img src=\"stlecture_ct_source_page_06_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=6\">Open source PDF</a>"
