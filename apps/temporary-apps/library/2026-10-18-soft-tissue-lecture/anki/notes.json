  {
    "id": "soft-tissue-lecture-v1-ct-4",
    "source_page_id": "ct-4",
    "source_title": "Subhawong et al. AJR 2010, Figure 4, PDF page 3.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "What is the most likely diagnosis?<br><br>{{c1::Synovial chondromatosis}}<br><br><img src=\"stlecture_ct_f04_single_v1.jpg\">",
      "Extra": "Multiple mineralized intraarticular bodies and adjacent smooth acetabular scalloping support the diagnosis.<br><br>Subhawong et al. AJR 2010, Figure 4, PDF page 3.<br><br><img src=\"stlecture_ct_source_page_03_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=3\">Open source PDF</a>"
    },
    "tags": [
