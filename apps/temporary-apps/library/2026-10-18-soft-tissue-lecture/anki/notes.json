[
  {
    "id": "soft-tissue-lecture-v1-ct-1",
    "source_page_id": "ct-1",
    "source_title": "Subhawong et al. AJR 2010, Figure 1, PDF page 2.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "Dermatomyositis. What is the most likely diagnosis?<br><br>{{c1::Calcinosis universalis}}<br><br><img src=\"stlecture_ct_f01_single_v1.jpg\">",
      "Extra": "Sheetlike soft-tissue calcification is the visual clue. This is calcification, rather than organized cortical and trabecular bone.<br><br>Subhawong et al. AJR 2010, Figure 1, PDF page 2.<br><br><img src=\"stlecture_ct_source_page_02_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=2\">Open source PDF</a>"
    },
    "tags": [
      "#AnkiChat::2026.10.19_Soft_Tissue_Lecture"
    ],
    "guid": "d]F<_`GnfJ",
    "media_files": [
      {
