  {
    "id": "soft-tissue-lecture-v1-ct-3",
    "source_page_id": "ct-3",
    "source_title": "Subhawong et al. AJR 2010, Figure 3, PDF page 2.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "Gout with elbow swelling. What is the most likely diagnosis?<br><br>{{c1::Gouty tophus}}<br><br><img src=\"stlecture_ct_f03_single_v1.jpg\">",
      "Extra": "A lobulated juxtaarticular mass at the olecranon contains amorphous calcification.<br><br>Subhawong et al. AJR 2010, Figure 3, PDF page 2.<br><br><img src=\"stlecture_ct_source_page_02_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=2\">Open source PDF</a>"
    },
    "tags": [
      "#AnkiChat::2026.10.19_Soft_Tissue_Lecture"
    ],
    "guid": "EHH5~p-U`&",
