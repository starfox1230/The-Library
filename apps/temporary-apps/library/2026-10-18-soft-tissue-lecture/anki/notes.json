  {
    "id": "soft-tissue-lecture-v1-ct-9",
    "source_page_id": "ct-9",
    "source_title": "Subhawong et al. AJR 2010, Figure 9, PDF page 5.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "What is the most likely diagnosis?<br><br>{{c1::Intramuscular lipoma}}<br><br><img src=\"stlecture_ct_f09_single_v1.jpg\">",
      "Extra": "The mass is predominantly uniform fat with only thin, architecture-preserving internal strands.<br><br>Subhawong et al. AJR 2010, Figure 9, PDF page 5.<br><br><img src=\"stlecture_ct_source_page_05_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=5\">Open source PDF</a>"
    },
