  {
    "id": "soft-tissue-lecture-v1-ct-10",
    "source_page_id": "ct-10",
    "source_title": "Subhawong et al. AJR 2010, Figure 10, PDF page 5.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "Enlarging thigh mass. What is the most likely diagnosis?<br><br>{{c1::Atypical lipomatous tumor / well-differentiated liposarcoma}}<br><br><img src=\"stlecture_ct_f10_single_v1.jpg\">",
      "Extra": "The fatty mass contains conspicuous nonfat nodules and soft-tissue strands, rather than the uniform architecture of a simple lipoma.<br><br>Subhawong et al. AJR 2010, Figure 10, PDF page 5.<br><br><img src=\"stlecture_ct_source_page_05_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=5\">Open source PDF</a>"
    },
