  {
    "id": "soft-tissue-lecture-v1-ct-12",
    "source_page_id": "ct-12",
    "source_title": "Subhawong et al. AJR 2010, Figure 12, PDF page 5.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "6-month-old with a chest mass. What is the most likely diagnosis?<br><br>{{c1::Lipoblastoma}}<br><br><img src=\"stlecture_ct_f12_single_v1.jpg\">",
      "Extra": "A large predominantly fatty mass in an infant favors lipoblastoma. Age is a critical discriminator from the usual adult lipomatous tumor differential.<br><br>Subhawong et al. AJR 2010, Figure 12, PDF page 5.<br><br><img src=\"stlecture_ct_source_page_05_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=5\">Open source PDF</a>"
