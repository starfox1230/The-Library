  {
    "id": "soft-tissue-lecture-v1-ct-8",
    "source_page_id": "ct-8",
    "source_title": "Subhawong et al. AJR 2010, Figure 8, PDF page 4.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "Young adult with a foot mass. What is the most likely diagnosis?<br><br>{{c1::Synovial sarcoma}}<br><br>1/2<br><img src=\"stlecture_ct_f08_A_v1.jpg\"><br><img src=\"stlecture_ct_f08_B_v1.jpg\">",
      "Extra": "The enhancing foot mass contains internal mineralization. The vascular reconstruction maps the arterial supply; these features raise suspicion but histology establishes the tumor type.<br><br>Subhawong et al. AJR 2010, Figure 8, PDF page 4.<br><br><img src=\"stlecture_ct_source_page_04_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=4\">Open source PDF</a>"
    },
