    "source_title": "Subhawong et al. AJR 2010, Figure 20, PDF page 7.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "What is the most likely diagnosis?<br><br>{{c1::Arteriovenous malformation}}<br><br><img src=\"stlecture_ct_f20_single_v1.jpg\">",
      "Extra": "The CT angiographic reconstruction shows an extensive abnormal vascular network at the wrist.<br><br>Subhawong et al. AJR 2010, Figure 20, PDF page 7.<br><br><img src=\"stlecture_ct_source_page_07_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=7\">Open source PDF</a>"
