  {
    "id": "soft-tissue-lecture-v1-ct-6",
    "source_page_id": "ct-6",
    "source_title": "Subhawong et al. AJR 2010, Figure 6, PDF page 4.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "Known osteosarcoma. What is the most likely diagnosis?<br><br>{{c1::Soft-tissue osteosarcoma metastases}}<br><br><img src=\"stlecture_ct_f06_single_v1.jpg\">",
      "Extra": "Cloudlike, centrally dense mineralization represents osteoid matrix in the soft-tissue deposits.<br><br>Subhawong et al. AJR 2010, Figure 6, PDF page 4.<br><br><img src=\"stlecture_ct_source_page_04_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=4\">Open source PDF</a>"
    },
