  {
    "id": "soft-tissue-lecture-v1-ct-11",
    "source_page_id": "ct-11",
    "source_title": "Subhawong et al. AJR 2010, Figure 11, PDF page 5.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "What is the most likely diagnosis?<br><br>{{c1::Liposarcoma}}<br><br><img src=\"stlecture_ct_f11_single_v1.jpg\">",
      "Extra": "Thick irregular septa and nodular nonfat components make this an aggressive-appearing fatty tumor. The image does not establish an exact histologic subtype or grade.<br><br>Subhawong et al. AJR 2010, Figure 11, PDF page 5.<br><br><img src=\"stlecture_ct_source_page_05_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=5\">Open source PDF</a>"
