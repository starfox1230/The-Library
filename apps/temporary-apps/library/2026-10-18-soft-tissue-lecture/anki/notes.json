  {
    "id": "soft-tissue-lecture-v1-mr-5",
    "source_page_id": "mr-5",
    "source_title": "Wu and Hochman. Radiology 2009, Figure 5, PDF page 7.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "What is the most likely diagnosis?<br><br>{{c1::Benign peripheral nerve sheath tumor}}<br><br><img src=\"stlecture_mr_f05_single_v1.jpg\">",
      "Extra": "The target sign has a T2-dark center and bright periphery. This caption-proven schwannoma demonstrates why the sign is not specific for neurofibroma.<br><br>Wu and Hochman. Radiology 2009, Figure 5, PDF page 7.<br><br><img src=\"stlecture_mr_source_page_07_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/mri-systematic-approach.pdf#page=7\">Open source PDF</a>"
    },
