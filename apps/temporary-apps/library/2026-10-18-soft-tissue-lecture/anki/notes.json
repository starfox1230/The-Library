    "source_title": "Wu and Hochman. Radiology 2009, Figure 3, PDF page 6.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "What is the most likely diagnosis?<br><br>{{c1::Ganglion cyst}}<br><br>1/2<br><img src=\"stlecture_mr_f03_a_v1.jpg\"><br><img src=\"stlecture_mr_f03_b_v1.jpg\">",
      "Extra": "The cystlike T2-bright lesion has a thin enhancing rim without internal solid enhancement.<br><br>Wu and Hochman. Radiology 2009, Figure 3, PDF page 6.<br><br><img src=\"stlecture_mr_source_page_06_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/mri-systematic-approach.pdf#page=6\">Open source PDF</a>"
