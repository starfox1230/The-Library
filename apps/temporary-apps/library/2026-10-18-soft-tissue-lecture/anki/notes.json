  {
    "id": "soft-tissue-lecture-v1-ct-5",
    "source_page_id": "ct-5",
    "source_title": "Subhawong et al. AJR 2010, Figure 5, PDF page 3.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "Young adult with a rapidly growing, painful thigh mass. What is the most likely diagnosis?<br><br>{{c1::Myositis ossificans}}<br><br>1/2<br><img src=\"stlecture_ct_f05_A_v1.jpg\"><br><img src=\"stlecture_ct_f05_B_v1.jpg\">",
      "Extra": "The peripheral zonal ossification on CT is the key discriminator. Early MRI enhancement and edema can mimic sarcoma.<br><br>Subhawong et al. AJR 2010, Figure 5, PDF page 3.<br><br><img src=\"stlecture_ct_source_page_03_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=3\">Open source PDF</a>"
    },
