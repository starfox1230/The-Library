  {
    "id": "soft-tissue-lecture-v1-ct-2",
    "source_page_id": "ct-2",
    "source_title": "Subhawong et al. AJR 2010, Figure 2, PDF page 2.",
    "deck_name": "Saved Cards",
    "note_type_style": "saCloze++",
    "fields": {
      "Text": "End-stage renal disease with hypercalcemia. What is the most likely diagnosis?<br><br>{{c1::Metastatic soft-tissue calcification}}<br><br><img src=\"stlecture_ct_f02_single_v1.jpg\">",
      "Extra": "The lobulated periarticular calcium deposits occur in a metabolic setting. Here metastatic refers to metabolic calcium deposition, not cancer spread.<br><br>Subhawong et al. AJR 2010, Figure 2, PDF page 2.<br><br><img src=\"stlecture_ct_source_page_02_v1.jpg\"><br><a href=\"https://starfox1230.github.io/The-Library/apps/temporary-apps/library/2026-10-18-soft-tissue-lecture/papers/ct-soft-tissue-masses.pdf#page=2\">Open source PDF</a>"
    },
    "tags": [
      "#AnkiChat::2026.10.19_Soft_Tissue_Lecture"
    ],
    "guid": "P^8[Pt`U=(",
